# Environment mode: dev or prod
DJANGO_ENV=dev
DEBUG=True
SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-32-chars

# Security
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8100,capacitor://localhost

# Database: PostgreSQL URL (leave unset or blank to use SQLite in dev)
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ML Service external URL
ML_SERVICE_URL=http://localhost:8001

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
